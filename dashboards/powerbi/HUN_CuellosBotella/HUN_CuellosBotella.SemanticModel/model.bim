            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Parquet.Document(File.Contents(RutaDatos & \"fact_transiciones.parquet\")),",
                "    Nombres = [#\"Inpatient Visit\" = \"Hospitalización\", #\"Emergency Room Visit\" = \"Urgencias · admisión\", #\"Treatment urgency {Diagnosis}\" = \"Urgencias · atención\", #\"Ambulatory Rehabilitation Visit\" = \"Rehabilitación ambulatoria\", #\"No matching concept\" = \"Sin clasificar\"],",
                "    Traducido = Table.TransformColumns(Origen, {{\"etapa_siguiente\", each Record.FieldOrDefault(Nombres, _, _), type text}}),",
                "    Recortado = Table.SelectRows(Traducido, each Date.From([mes]) <= FechaCorte)",
                "in",
                "    Recortado"
              ]
            }
          }
        ],
        "isHidden": false
