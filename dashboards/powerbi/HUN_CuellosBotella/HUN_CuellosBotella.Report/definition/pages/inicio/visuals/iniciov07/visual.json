    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Cómo leer el semáforo",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#1F4E79",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cada área se compara con su propia historia, hora a hora:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "● Verde · normal: ",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2E9E6A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "el número de pacientes presentes está por debajo de su percentil 75 histórico.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "● Amarillo · alerta: ",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#C98A00",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "está entre el percentil 75 y el 90; hay presión y conviene vigilar.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "● Rojo · saturación: ",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#D64550",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "supera el percentil 90; solo 1 de cada 10 horas de la historia estuvo tan llena.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Estado del área en el periodo: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "por construcción, un área normal pasa 10 % de sus horas en rojo y 25 % en alerta. Si en el periodo elegido supera el 10 % en rojo se marca roja; si supera el 25 % en alerta, amarilla.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Puntaje cuello de botella (0 a 100): ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "resume en un número qué tan congestionada está un área: 50 % por saturación, 30 % por horas en alerta y 20 % por si sus estancias se están alargando. Más alto = más crítico.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
