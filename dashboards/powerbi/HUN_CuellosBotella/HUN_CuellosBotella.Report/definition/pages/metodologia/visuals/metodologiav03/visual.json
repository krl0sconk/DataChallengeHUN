                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "De mayo a agosto de 2026 la extracción viene incompleta; por eso se excluye (parámetro FechaCorte).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Los nombres de las áreas son traducciones de los conceptos OMOP de visita.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rehabilitación ambulatoria no registra hora de salida, por eso no tiene censo ni duración.",
