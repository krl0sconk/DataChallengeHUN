                      "fontSize": "11.5pt",
                      "color": "#1F4E79",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Censo:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " pacientes presentes en el área en una hora dada.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Umbral preventivo (p75) / crítico (p90):",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " censo que solo se supera el 25 % / 10 % de las horas históricas.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Índice de saturación:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " censo promedio ÷ umbral crítico. 100 % = estar en el p90 todo el tiempo.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• % horas en alerta:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " horas en amarillo o rojo sobre el total de horas observadas.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Días con alerta roja:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " días con al menos una hora por encima del p90.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Duración p90:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " tiempo en la etapa que supera solo el 10 % de los pacientes.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Espera entre etapas:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " marcas OMOP; p90 mensual ponderado, sin equivalencia a espera por cama.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Puntaje cuello de botella:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " 0-100 = 50 % saturación + 30 % horas en alerta + 20 % alargamiento de la estancia.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
