# Copia este archivo como .env y ajusta los valores. El .env NUNCA se sube.
# Las rutas relativas se resuelven desde la raíz del repositorio.

HUN_DATA_DIR=data
HUN_RAW_DIR=data/raw
HUN_EXTERNAL_DIR=data/external
HUN_INTERIM_DIR=data/interim
HUN_PROCESSED_DIR=data/processed
HUN_MODELS_DIR=models
HUN_FIGURES_DIR=reports/figures

# API de clima (dejar vacío si no se usa o si la API no requiere clave)
WEATHER_API_KEY=

# Ubicación del hospital (Barranquilla / Puerto Colombia)
HUN_LATITUDE=11.0190
HUN_LONGITUDE=-74.8511
HUN_TIMEZONE=America/Bogota

HUN_RANDOM_SEED=42

# --- Base de datos del hospital (PostgreSQL por VPN, SOLO LECTURA) ---
# Los valores están en el correo de los organizadores del 9 de octubre de 2026
# ("Data Challenge HUN 2026" y "Usuario y contraseña de acceso..."). NO los escribas aquí:
# este archivo se sube al repo. Cópialos solo en tu .env.
HUN_DB_HOST=
HUN_DB_PORT=
HUN_DB_NAME=
HUN_DB_USER=
HUN_DB_PASSWORD=
# El correo dice "uninorte_omo"; el diccionario usa "uninorte_omop". Verifica con
# `python -m hun.data.conexion` cuál existe y deja el correcto.
HUN_DB_SCHEMA=uninorte_omop
# Tiempo máximo por consulta (segundos). Corta consultas que saturarían la base.
HUN_DB_TIMEOUT_S=120
