# Copia este archivo como .env y ajusta los valores. El .env NUNCA se sube.
# Las rutas relativas se resuelven desde la raíz del repositorio.

HUN_DATA_DIR=data
HUN_RAW_DIR=data/raw
HUN_EXTERNAL_DIR=data/external
HUN_INTERIM_DIR=data/interim
HUN_PROCESSED_DIR=data/processed
HUN_MODELS_DIR=models
HUN_FIGURES_DIR=reports/figures

# API de clima (dejar vacío si no se usa o si la API no requiere clave)
WEATHER_API_KEY=

# Ubicación del hospital (Barranquilla / Puerto Colombia)
HUN_LATITUDE=11.0190
HUN_LONGITUDE=-74.8511
HUN_TIMEZONE=America/Bogota

HUN_RANDOM_SEED=42
